{
  "schemaVersion": 1,
  "id": "reachfly",
  "version": "${version}",
  "name": "f1sch client",
  "description": "A client-side mod with reach, fly, ESP, Jesus, NoFall, Fullbright, Speed, auto-combat, elytra swap, fly-to-coords, and more.",
  "authors": ["f1schDev"],
  "contact": {
    "sources": "https://github.com/minerofthesoal/reach"
  },
  "license": "Apache-2.0",
  "icon": "assets/reachfly/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.reachfly.ReachFlyClient"],
    "modmenu": ["com.reachfly.ModMenuIntegration"]
  },
  "mixins": ["reachfly.mixins.json"],
  "accessWidener": "reachfly.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
